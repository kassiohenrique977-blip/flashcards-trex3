{
  "configVersion": "v3",
  "app": {
    "appId": 1095532,
    "appName": "Flashcards",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "flashcards",
    "description": "Flashcards com repetição espaçada, estudo offline"
  },
  "permissions": ["data:os.device.info", "device:os.local_storage"],
  "runtime": {
    "apiVersion": {
      "compatible": "1.0",
      "target": "1.0",
      "minVersion": "3.0"
    }
  },
  "debug": false,
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/home/index.page",
            "page/onboarding/index.page",
            "page/study/index.page",
            "page/summary/index.page",
            "page/sync/index.page"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Flashcards"
    }
  },
  "defaultLanguage": "en-US"
}
