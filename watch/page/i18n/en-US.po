msgid "demo.name"
msgstr "Demo"

msgid "demo.q1"
msgstr "What is this app for?"

msgid "demo.a1"
msgstr "Studying flashcards on the watch, offline"

msgid "demo.q2"
msgstr "How do cards get to the watch?"

msgid "demo.a2"
msgstr "From the phone app, by tapping SYNC"

msgid "demo.q3"
msgstr "What does AGAIN mean?"

msgid "demo.a3"
msgstr "You forgot the card: it comes back in this session"

msgid "demo.q4"
msgstr "What does EASY mean?"

msgid "demo.a4"
msgstr "It was effortless: the card comes back much later"

msgid "demo.q5"
msgstr "Do you need internet to study?"

msgid "demo.a5"
msgstr "No. Everything works offline on the watch"

msgid "demo.q6"
msgstr "Where do your answers go?"

msgid "demo.a6"
msgstr "They stay on the watch until the next sync"

msgid "demo.q7"
msgstr "What is spaced repetition?"

msgid "demo.a7"
msgstr "Reviewing right before you would forget"

msgid "demo.q8"
msgstr "Which button shows the answer?"

msgid "demo.a8"
msgstr "SHOW, or the select button on the watch"
