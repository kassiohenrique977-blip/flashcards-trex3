msgid "tour.welcome.title"
msgstr "FLASHCARDS"

msgid "tour.welcome.text"
msgstr "Study your cards on the watch, offline, without carrying your phone."

msgid "tour.how.title"
msgstr "HOW IT WORKS"

msgid "tour.how.text"
msgstr "1. Create or import cards in the phone app.\n2. Tap SYNC.\n3. Study here, offline."

msgid "tour.study.title"
msgstr "STUDYING"

msgid "tour.study.text"
msgstr "Tap SHOW and answer: AGAIN, HARD, GOOD or EASY. Your answer sets when the card comes back."

msgid "tour.back.title"
msgstr "BACK TO THE PHONE"

msgid "tour.back.text"
msgstr "Your answers stay here until you sync again. Nothing is lost."

msgid "tour.qr.title"
msgstr "PHONE APP"

msgid "tour.qr.text"
msgstr "Scan the code with your phone camera to install:"

