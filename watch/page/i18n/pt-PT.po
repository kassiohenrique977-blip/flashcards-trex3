msgstr "PRÓXIMO"

msgid "tour.yes"
msgstr "SIM, COMEÇAR"

msgid "tour.notYet"
msgstr "AINDA NÃO"

msgid "demo.name"
msgstr "Demonstração"

msgid "demo.q1"
msgstr "Para que serve este app?"

msgid "demo.a1"
msgstr "Estudar flashcards no relógio, offline"

msgid "demo.q2"
msgstr "Como os cartões chegam ao relógio?"

msgid "demo.a2"
msgstr "Do app do telemóvel, tocando em SINCRONIZAR"

msgid "demo.q3"
msgstr "O que significa ERREI?"

msgid "demo.a3"
msgstr "Você esqueceu o cartão: ele volta nesta sessão"

msgid "demo.q4"
msgstr "O que significa FÁCIL?"

msgid "demo.a4"
msgstr "Não custou nada: o cartão volta bem mais tarde"

msgid "demo.q5"
msgstr "Precisa de internet para estudar?"

msgid "demo.a5"
msgstr "Não. Tudo funciona offline no relógio"

msgid "demo.q6"
msgstr "Para onde vão suas respostas?"

msgid "demo.a6"
msgstr "Ficam no relógio até a próxima sincronização"

msgid "demo.q7"
msgstr "O que é repetição espaçada?"

msgid "demo.a7"
msgstr "Revisar pouco antes de você esquecer"

msgid "demo.q8"
msgstr "Qual botão mostra a resposta?"

msgid "demo.a8"
msgstr "MOSTRAR, ou o botão de seleção do relógio"
