msgid "tour.welcome.title"
msgstr "FLASHCARDS"

msgid "tour.welcome.text"
msgstr "Estude seus cartões no relógio, sem internet e sem levar o telemóvel."

msgid "tour.how.title"
msgstr "COMO FUNCIONA"

msgid "tour.how.text"
msgstr "1. Crie ou importe cartões no app do telemóvel.\n2. Toque em SINCRONIZAR.\n3. Estude aqui, offline."

msgid "tour.study.title"
msgstr "ESTUDANDO"

msgid "tour.study.text"
msgstr "Toque em MOSTRAR e responda: ERREI, DIFÍCIL, BOM ou FÁCIL. Cada resposta define quando o cartão volta."

msgid "tour.back.title"
msgstr "DE VOLTA AO TELEMÓVEL"

msgid "tour.back.text"
msgstr "Suas respostas ficam guardadas aqui até você sincronizar de novo. Nada se perde."

msgid "tour.qr.title"
msgstr "APP DO TELEMÓVEL"

msgid "tour.qr.text"
msgstr "Leia o código com a câmara do telemóvel para instalar:"

msgid "tour.confirm.title"
msgstr "TUDO PRONTO?"

msgid "tour.confirm.text"
msgstr "Você já instalou o app Flashcards no telemóvel?"

